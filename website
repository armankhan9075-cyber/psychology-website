const AppContent = () => {
  const { route, navigate } = useContext(AppContext);

  // Implement Exit Intent Popup Logic for GTM Practice
  useEffect(() => {
    const handleMouseLeave = (e) => {
      if (e.clientY <= 0 && !sessionStorage.getItem('exitPopupShown')) {
        // Trigger generic custom event for GTM
        document.dispatchEvent(new CustomEvent('exit_intent_triggered'));
        sessionStorage.setItem('exitPopupShown', 'true');
        // A real app would show a modal here. Keeping it abstract for sandbox focus.
        console.log("Exit intent triggered!");
      }
    };
    document.addEventListener('mouseleave', handleMouseLeave);
    return () => document.removeEventListener('mouseleave', handleMouseLeave);
  }, []);

  // Simple Router Switch
  let Content;
  switch (route.path) {
    case '/': Content = <Homepage />; break;
    case '/shop': Content = <ShopPage params={route.params} />; break;
    case '/product': Content = <ProductDetail params={route.params} />; break;
    case '/checkout': Content = <Checkout />; break;
    case '/order-confirmation': Content = <OrderConfirmation params={route.params} />; break;
    case '/journal': Content = <Journal />; break;
    case '/business': Content = <BusinessLeadGen />; break;
    case '/login': Content = <div className="py-32 text-center text-xl bg-[#F5F5F0] min-h-screen">Login Page Mockup <br/><br/> <Button onClick={()=>navigate('/')}>Back Home</Button></div>; break;
    default: Content = <div className="py-32 text-center text-xl bg-[#F5F5F0] min-h-screen">404 - Page Not Found <br/><br/> <Button onClick={()=>navigate('/')}>Back Home</Button></div>; break;
  }

  // GA4 Pageview Simulator
  useEffect(() => {
    // In a real setup, this triggers the GA4 tag.
    // We expose it cleanly so GTM's history change trigger works, or custom event.
    console.log(`GA4 Virtual Pageview: ${route.path}`);
  }, [route.path]);

  return (
    <div className="font-sans text-[#171717] antialiased selection:bg-[#D97745] selection:text-white min-h-screen flex flex-col">
      {/* Expose data-layer attributes on body for easy access if needed, though mostly using explicit data-gtm-event on elements */}
      <Header />
      <main className="flex-grow flex flex-col">
        {Content}
      </main>
      {route.path !== '/checkout' && <Footer />}
      <ToastContainer />
    </div>
  );
};

export default function App() {
  return (
    <AppProvider>
      <AppContent />
    </AppProvider>
  );
}
