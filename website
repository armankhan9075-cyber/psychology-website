const ShopPage = ({ params }) => {
  const { category: initCategory, search } = params || {};
  const [filter, setFilter] = useState(initCategory || 'All');
  const [sort, setSort] = useState('featured');

  const filteredProducts = useMemo(() => {
    let result = [...PRODUCTS];
    if (filter !== 'All') result = result.filter(p => p.category === filter);
    if (search) result = result.filter(p => p.name.toLowerCase().includes(search.toLowerCase()) || p.description.toLowerCase().includes(search.toLowerCase()));
    
    switch(sort) {
      case 'price-low': return result.sort((a, b) => a.price - b.price);
      case 'price-high': return result.sort((a, b) => b.price - a.price);
      case 'newest': return result.filter(p => p.tags.includes('new'));
