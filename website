          </form>
        )}

        {step === 3 && (
          <form onSubmit={handlePlaceOrder} data-gtm-event="purchase_submit">
             <div className="border border-gray-200 rounded-lg p-4 mb-8 text-sm">
                <div className="flex justify-between">
                  <span className="text-gray-500">Method</span>
                  <span>Standard Shipping</span>
                </div>
            </div>
            <h2 className="text-xl font-medium mb-6">Payment</h2>
            <p className="text-sm text-gray-500 mb-4">All transactions are secure and encrypted. (Simulated)</p>
            <div className="border border-gray-200 p-6 bg-gray-50 rounded-lg space-y-4">
              <Input label="Card number" placeholder="0000 0000 0000 0000" name="card" value={formData.card} onChange={handleChange} required />
              <div className="grid grid-cols-2 gap-4">
                 <Input label="Expiration date (MM/YY)" placeholder="MM/YY" required />
