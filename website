const AppContext = createContext();

const AppProvider = ({ children }) => {
  const [cart, setCart] = useState([]);
  const [wishlist, setWishlist] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [isSearchOpen, setIsSearchOpen] = useState(false);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [user, setUser] = useState(null);
  const [toasts, setToasts] = useState([]);
  
  // Simple Router State
  const [route, setRoute] = useState({ path: '/', params: {} });

  const navigate = (path, params = {}) => {
    window.scrollTo(0, 0);
    setIsMenuOpen(false);
    setIsCartOpen(false);
    setIsSearchOpen(false);
    setRoute({ path, params });
  };

  const addToCart = (product, variant, quantity = 1) => {
    setCart(prev => {
      const existing = prev.find(item => item.id === product.id && item.variant === variant);
      if (existing) {
        return prev.map(item => item === existing ? { ...item, quantity: item.quantity + quantity } : item);
      }
      return [...prev, { ...product, variant, quantity }];
    });
    setIsCartOpen(true);
    addToast(`${product.name} added to cart.`);
  };

  const updateCartQuantity = (id, variant, delta) => {
    setCart(prev => prev.map(item => {
      if (item.id === id && item.variant === variant) {
        const newQ = Math.max(1, item.quantity + delta);
        return { ...item, quantity: newQ };
      }
      return item;
    }));
  };

  const removeFromCart = (id, variant) => {
    setCart(prev => prev.filter(item => !(item.id === id && item.variant === variant)));
  };

  const toggleWishlist = (product) => {
    setWishlist(prev => {
      const exists = prev.find(item => item.id === product.id);
      if (exists) {
        addToast('Removed from wishlist.');
        return prev.filter(item => item.id !== product.id);
      }
      addToast('Added to wishlist.');
      return [...prev, product];
    });
  };

  const addToast = (message, type = 'success') => {
    const id = Date.now();
    setToasts(prev => [...prev, { id, message, type }]);
    setTimeout(() => {
      setToasts(prev => prev.filter(t => t.id !== id));
    }, 3000);
  };

  const cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

  return (
    <AppContext.Provider value={{
      cart, addToCart, updateCartQuantity, removeFromCart, cartTotal, setCart,
      wishlist, toggleWishlist,
      isCartOpen, setIsCartOpen,
      isSearchOpen, setIsSearchOpen,
      isMenuOpen, setIsMenuOpen,
      user, setUser,
      toasts, addToast,
      route, navigate
    }}>
      {children}
    </AppContext.Provider>
  );
};

const Button = ({ children, variant = 'primary', className = '', onClick, type = 'button', gtmEvent, gtmData = {}, disabled }) => {
  const baseStyle = "inline-flex items-center justify-center px-6 py-3 text-sm font-medium transition-colors duration-200 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed";
  const variants = {
    primary: "bg-[#111111] text-[#F5F5F0] hover:bg-black",
    secondary: "bg-transparent border border-[#111111] text-[#111111] hover:bg-gray-50",
    accent: "bg-[#D97745] text-white hover:bg-[#c26538]",
    ghost: "bg-transparent text-[#111111] hover:bg-gray-100"
  };

  // Convert gtmData object to data-* attributes
  const dataAttributes = Object.entries(gtmData).reduce((acc, [key, value]) => {
    acc[`data-${key}`] = value;
    return acc;
  }, {});

  return (
    <button
      type={type}
      onClick={onClick}
      disabled={disabled}
      className={`${baseStyle} ${variants[variant]} ${className}`}
      data-gtm-event={gtmEvent || 'button_click'}
      {...dataAttributes}
    >
      {children}
    </button>
  );
};

const Link = ({ children, to, params, className = '', gtmEvent = 'navigation_click', gtmData = {} }) => {
  const { navigate } = useContext(AppContext);
  const dataAttributes = Object.entries(gtmData).reduce((acc, [key, value]) => { acc[`data-${key}`] = value; return acc; }, {});
  
  return (
    <a
      href={`#${to}`}
      onClick={(e) => {
        e.preventDefault();
        navigate(to, params);
      }}
      className={`cursor-pointer ${className}`}
      data-gtm-event={gtmEvent}
      data-nav-to={to}
      {...dataAttributes}
    >
      {children}
    </a>
  );
};

